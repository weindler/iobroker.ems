{
	"name": "iobroker.ems",
	"version": "0.2.13",
	"description": "EMS-Light ioBroker adapter — energy management with learning, policies, and safe dryrun/live execution",
	"author": {
		"name": "weindler"
	},
	"homepage": "https://github.com/weindler/iobroker.ems",
	"bugs": {
		"url": "https://github.com/weindler/iobroker.ems/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/weindler/iobroker.ems.git"
	},
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"@iobroker/adapter-core": "^3.3.2"
	},
	"devDependencies": {
		"@types/node": "^22.20.1",
		"typescript": "~5.4.5"
	},
	"main": "build/main.js",
	"files": [
		"admin/",
		"build/",
		"io-package.json",
		"LICENSE",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"watch": "tsc -p tsconfig.build.json --watch",
		"check": "tsc --noEmit -p tsconfig.json",
		"audit:states": "npm run build && node build/audit/run_state_surface_audit.js",
		"admin-config:generate": "npm run build && node build/tools/admin_config/generate.js",
		"admin-config:check": "npm run build && node build/tools/admin_config/generate.js --check",
		"test": "npm run build && node build/tools/admin_config/generate.js --check && node tools/run-unit-tests.mjs",
		"lint": "npm run check",
		"vis:generate": "node vis/generate-ems-view.mjs"
	}
}
